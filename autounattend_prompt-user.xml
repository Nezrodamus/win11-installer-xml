<?xml version="1.0" encoding="utf-8"?>
<!--
    ════════════════════════════════════════════════════════════════════
    CTC Unattended Windows 11 Install - PROMPT USER variant
    ════════════════════════════════════════════════════════════════════

    ⚠ REWORKED 2026-09-16 - FIXED BY DESIGN, NOT YET FIELD-TESTED ⚠

        WHAT WENT WRONG BEFORE
        This file used to set HideOnlineAccountScreens=true AND
        HideWirelessSetupInOOBE=true while defining no account. Between
        them those removed both routes to a local account - the
        Microsoft-account path and the network page where "I don't have
        internet" lives - so OOBE had nowhere to land. The install
        completed, rebooted, and stopped at
            "Windows could not complete the installation.
             To install Windows on this computer, restart the
             installation."
        Confirmed failing that way on 26100.8037 (24H2) and 26200.9168
        (25H2).

        WHAT CHANGED
        1. Both of those settings are gone, so the network page is shown.
        2. The specialize pass now sets BypassNRO=1 before OOBE starts,
           which puts "I don't have internet" back on that page.

        Microsoft removed the bypassnro.cmd SCRIPT in 26100.3775, but the
        registry value still works when written directly.

        EXPECTED FLOW
        Network page -> "I don't have internet" -> "Continue with limited
        setup" -> type the account name. Everything else stays automatic:
        hardware bypasses, debloat, telemetry off, privacy page skipped.

        STATUS
        Not yet proven on hardware. This variant has failed twice before,
        so verify on a test machine before using it on a customer's.
        autounattend_predefined-user.xml remains the safe choice - it
        defines the account outright and cannot hit this class of problem.

        IF IT STILL STRANDS AT THE NETWORK PAGE
        Shift+F10, then:  start ms-cxh:localonly
        Confirmed working on 26100.8037.

    PURPOSE
        Unattended Win11 install that prompts for a username during
        the OOBE account-creation step. All bypasses, telemetry
        disables, and bloatware stripping still happen automatically.
        Use when you're delivering the machine to a specific person
        and want their preferred name on the account from day one.

        For the variant that creates a "User" account silently with
        no prompt, see autounattend_predefined-user.xml.

    USAGE
        Rename a copy of this file to "autounattend.xml" and put it
        on the ROOT of a Windows 11 install USB. See README.txt in
        this folder for the full build flow.

    WHAT IT DOES
        windowsPE pass    Bypasses TPM / Secure Boot / RAM / CPU /
                          Storage / MoSetup checks so older hardware
                          installs cleanly.
        specialize pass   Sets timezone, disables CEIP, computer name
                          auto-generated.
        oobeSystem pass   Skips online-account screens, EULA, OEM
                          registration, and wireless. PROMPTS user to
                          enter a local account name during setup.
                          Runs FirstLogonCommands of registry tweaks
                          to disable telemetry, ads, Cortana, etc.

    LOCAL-ACCOUNT NOTE
        HideOnlineAccountScreens=true keeps OOBE from forcing a
        Microsoft Account. The user creates a LOCAL account in OOBE.
        Customers can still sign into Word / Excel / Store with a
        personal MSA AFTER install because the auth broker
        (XboxIdentityProvider) is intentionally NOT removed - see
        FirstLogonCommand #20 below for the regex.

    IF YOU EDIT THIS FILE
        Do NOT add "XboxIdentityProvider" back into the FirstLogon
        regex. It is the Live ID / MSA token broker, not a game app.
        Removing it breaks Store / OneDrive Personal / Office MSA
        sign-in for the life of the install.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

    <!-- ═══════════════════════════════════════════════════════════
         WINDOWS PREINSTALLATION ENVIRONMENT (WinPE)
         ═══════════════════════════════════════════════════════════ -->
    <settings pass="windowsPE">

        <component name="Microsoft-Windows-Setup" processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35" language="neutral"
                   versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

            <RunSynchronous>
                <RunSynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <Path>reg add "HKLM\SYSTEM\Setup\LabConfig" /v "BypassTPMCheck" /t REG_DWORD /d 1 /f</Path>
                </RunSynchronousCommand>
                <RunSynchronousCommand wcm:action="add">
                    <Order>2</Order>
                    <Path>reg add "HKLM\SYSTEM\Setup\LabConfig" /v "BypassSecureBootCheck" /t REG_DWORD /d 1 /f</Path>
                </RunSynchronousCommand>
                <RunSynchronousCommand wcm:action="add">
                    <Order>3</Order>
                    <Path>reg add "HKLM\SYSTEM\Setup\LabConfig" /v "BypassRAMCheck" /t REG_DWORD /d 1 /f</Path>
                </RunSynchronousCommand>
                <RunSynchronousCommand wcm:action="add">
                    <Order>4</Order>
                    <Path>reg add "HKLM\SYSTEM\Setup\LabConfig" /v "BypassStorageCheck" /t REG_DWORD /d 1 /f</Path>
                </RunSynchronousCommand>
                <RunSynchronousCommand wcm:action="add">
                    <Order>5</Order>
                    <Path>reg add "HKLM\SYSTEM\Setup\LabConfig" /v "BypassCPUCheck" /t REG_DWORD /d 1 /f</Path>
                </RunSynchronousCommand>
                <RunSynchronousCommand wcm:action="add">
                    <Order>6</Order>
                    <Path>reg add "HKLM\SYSTEM\Setup\MoSetup" /v "AllowUpgradesWithUnsupportedTPMOrCPU" /t REG_DWORD /d 1 /f</Path>
                </RunSynchronousCommand>
            </RunSynchronous>

            <UserData>
                <!-- No <ProductKey> on purpose. This lets Windows Setup behave like a
                     normal install for licensing/edition:
                       * Firmware-embedded (OEM/MSDM) key present  -> Setup reads it from
                         the BIOS, auto-selects that edition, and never prompts.
                       * No firmware key (e.g. a digital-license-only / upgraded machine)
                         -> Setup shows the edition picker (choose Home/Pro/etc.) and a
                         product-key page you can SKIP via "I don't have a product key".
                         Activation then comes from the machine's existing digital license
                         once it is online, or you can enter a key later in the OS.
                     Adding a key here would FORCE one edition and suppress both the
                     auto-detect and the edition choice, so it is intentionally omitted. -->
                <AcceptEula>true</AcceptEula>
                <FullName>User</FullName>
                <Organization></Organization>
            </UserData>

        </component>

        <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35" language="neutral"
                   versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
            <SetupUILanguage>
                <UILanguage>en-US</UILanguage>
            </SetupUILanguage>
            <InputLocale>en-US</InputLocale>
            <SystemLocale>en-US</SystemLocale>
            <UILanguage>en-US</UILanguage>
            <UserLocale>en-US</UserLocale>
        </component>

    </settings>

    <!-- ═══════════════════════════════════════════════════════════
         SPECIALIZE
         ═══════════════════════════════════════════════════════════ -->
    <settings pass="specialize">

        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35" language="neutral"
                   versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
            <ComputerName>*</ComputerName>
            <TimeZone>US Mountain Standard Time</TimeZone>
        </component>

        <!-- ════════════════════════════════════════════════════════════
             REMOVED 2026-09-05: Microsoft-Windows-SQMAPI / CEIPEnabled.
             See autounattend_predefined-user.xml for the full reasoning.
             Short version: a component absent from the image fails its
             pass, and a failed specialize pass stops the machine before
             OOBE. CEIPEnabled duplicated AllowTelemetry=0 anyway.
             ════════════════════════════════════════════════════════════ -->

        <!-- Privacy settings applied in specialize, not FirstLogonCommands,
             so the OOBE privacy page is skipped rather than answered. -->
        <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35" language="neutral"
                   versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
            <RunSynchronous>

                <RunSynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <Description>Skip the OOBE privacy questions entirely</Description>
                    <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\OOBE" /v "DisablePrivacyExperience" /t REG_DWORD /d 1 /f</Path>
                </RunSynchronousCommand>

                <RunSynchronousCommand wcm:action="add">
                    <Order>2</Order>
                    <Description>Diagnostic data off</Description>
                    <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection" /v "AllowTelemetry" /t REG_DWORD /d 0 /f</Path>
                </RunSynchronousCommand>

                <RunSynchronousCommand wcm:action="add">
                    <Order>3</Order>
                    <Description>Location services off</Description>
                    <Path>reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Sensor\Overrides\{BFA794E4-F964-4FDB-90F6-51056BFE4B44}" /v "SensorPermissionState" /t REG_DWORD /d 0 /f</Path>
                </RunSynchronousCommand>

                <RunSynchronousCommand wcm:action="add">
                    <Order>4</Order>
                    <Description>Location service disabled</Description>
                    <Path>reg add "HKLM\SYSTEM\CurrentControlSet\Services\lfsvc\Service\Configuration" /v "Status" /t REG_DWORD /d 0 /f</Path>
                </RunSynchronousCommand>

                <RunSynchronousCommand wcm:action="add">
                    <Order>5</Order>
                    <Description>Find My Device off</Description>
                    <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\FindMyDevice" /v "AllowFindMyDevice" /t REG_DWORD /d 0 /f</Path>
                </RunSynchronousCommand>

                <RunSynchronousCommand wcm:action="add">
                    <Order>6</Order>
                    <Description>Consumer features off, machine-wide</Description>
                    <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" /v "DisableWindowsConsumerFeatures" /t REG_DWORD /d 1 /f</Path>
                </RunSynchronousCommand>

                <RunSynchronousCommand wcm:action="add">
                    <Order>7</Order>
                    <Description>Advertising ID off by policy</Description>
                    <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\AdvertisingInfo" /v "DisabledByGroupPolicy" /t REG_DWORD /d 1 /f</Path>
                </RunSynchronousCommand>

                <RunSynchronousCommand wcm:action="add">
                    <Order>8</Order>
                    <Description>Inking and typing personalisation off</Description>
                    <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\InputPersonalization" /v "RestrictImplicitTextCollection" /t REG_DWORD /d 1 /f</Path>
                </RunSynchronousCommand>

                <!-- ════════════════════════════════════════════════════════
                     THIS IS WHAT MAKES THE "TYPE THE NAME" FLOW WORK.

                     Setting BypassNRO before OOBE starts puts the "I don't
                     have internet" option back on the network page, which
                     leads to "Continue with limited setup" and then the
                     local-account creation page.

                     Microsoft removed the bypassnro.cmd SCRIPT in build
                     26100.3775, but the registry value it used to write
                     still works when set directly - which is what this does,
                     early enough that OOBE sees it on first run with no
                     Shift+F10 needed.

                     If a future build closes this too, the manual escape is
                     Shift+F10 at the network page then:  start ms-cxh:localonly
                     (confirmed working on 26100.8037).
                     ════════════════════════════════════════════════════════ -->
                <RunSynchronousCommand wcm:action="add">
                    <Order>9</Order>
                    <Description>Allow a local account without a network connection</Description>
                    <Path>reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" /v "BypassNRO" /t REG_DWORD /d 1 /f</Path>
                </RunSynchronousCommand>

            </RunSynchronous>
        </component>

    </settings>

    <!-- ═══════════════════════════════════════════════════════════
         OOBE
         VERSION: prompt-user
         No account is predefined. Windows will ask for a username
         and password during OOBE. All cleanup still runs on first login.
         ═══════════════════════════════════════════════════════════ -->
    <settings pass="oobeSystem">

        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35" language="neutral"
                   versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

            <!-- ════════════════════════════════════════════════════════
                 DO NOT set HideOnlineAccountScreens or
                 HideWirelessSetupInOOBE here.

                 Those two were what broke this variant. Between them they
                 removed BOTH routes to a local account:

                   HideOnlineAccountScreens  killed the Microsoft-account
                                             path, expecting OOBE to fall
                                             through to a local-account
                                             page that no longer exists
                   HideWirelessSetupInOOBE   killed the network page, which
                                             is where "I don't have
                                             internet" lives

                 With no account defined either, OOBE had nowhere to go and
                 the install died with "Windows could not complete the
                 installation."

                 Leaving the network page visible, with BypassNRO set during
                 specialize, gives it somewhere to go.
                 ════════════════════════════════════════════════════════ -->
            <OOBE>
                <HideEULAPage>true</HideEULAPage>
                <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
                <NetworkLocation>Work</NetworkLocation>
                <ProtectYourPC>3</ProtectYourPC>
                <UnattendEnableRetailDemo>false</UnattendEnableRetailDemo>
            </OOBE>

            <!-- No UserAccounts block on purpose — the whole point of this
                 variant is that whoever sets the machine up types the name.
                 See the specialize pass for the BypassNRO value that makes
                 the local-account route reachable. -->

            <FirstLogonCommands>

                <SynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <CommandLine>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection" /v "AllowTelemetry" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>2</Order>
                    <CommandLine>reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\AdvertisingInfo" /v "Enabled" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>3</Order>
                    <CommandLine>reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Sensor\Overrides\{BFA794E4-F964-4FDB-90F6-51056BFE4B44}" /v "SensorPermissionState" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>4</Order>
                    <CommandLine>reg add "HKLM\SYSTEM\CurrentControlSet\Services\lfsvc\Service\Configuration" /v "Status" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>5</Order>
                    <CommandLine>reg add "HKLM\SOFTWARE\Policies\Microsoft\FindMyDevice" /v "AllowFindMyDevice" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>6</Order>
                    <CommandLine>reg add "HKCU\SOFTWARE\Microsoft\Siuf\Rules" /v "NumberOfSIUFInPeriod" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>7</Order>
                    <CommandLine>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\Windows Search" /v "AllowCortana" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>8</Order>
                    <CommandLine>reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "SubscribedContent-338388Enabled" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>9</Order>
                    <CommandLine>reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "SubscribedContent-338389Enabled" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>10</Order>
                    <CommandLine>reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "SystemPaneSuggestionsEnabled" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>11</Order>
                    <CommandLine>reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "SilentInstalledAppsEnabled" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>12</Order>
                    <CommandLine>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" /v "DisableWindowsConsumerFeatures" /t REG_DWORD /d 1 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>13</Order>
                    <CommandLine>reg add "HKCU\SOFTWARE\Policies\Microsoft\Windows\Explorer" /v "DisableSearchBoxSuggestions" /t REG_DWORD /d 1 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>14</Order>
                    <CommandLine>reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v "HideFileExt" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>15</Order>
                    <CommandLine>reg add "HKCU\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32" /ve /t REG_SZ /d "" /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>16</Order>
                    <CommandLine>cmd /c reg delete "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Run" /v "OneDrive" /f 2>nul</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>17</Order>
                    <CommandLine>powercfg /setactive 381b4222-f694-41f0-9685-ff5bb260df2e</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>18</Order>
                    <CommandLine>sc config DiagTrack start= disabled</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>19</Order>
                    <CommandLine>sc stop DiagTrack</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>20</Order>
                    <!-- IMPORTANT: Do NOT include 'XboxIdentityProvider' here. It is the Microsoft
                         Account / Live ID token broker used by the Microsoft Store, OneDrive Personal,
                         Family Safety, Game Pass, and parental controls. Removing it breaks Store
                         sign-in for the life of the install. Xbox *Game* surfaces (overlays, GamingApp)
                         are safe to remove. -->
                    <CommandLine>cmd /c powershell -NonInteractive -NoProfile -ExecutionPolicy Bypass -Command "$p='Clipchamp|BingNews|BingWeather|BingSearch|GamingApp|MixedReality|3DViewer|Paint3D|Solitaire|ZuneMusic|ZuneVideo|XboxSpeechToTextOverlay|XboxGamingOverlay|XboxGameOverlay|Xbox.TCUI|549981C3F5F10|Teams|GetHelp|Getstarted|windowscommunicationsapps|YourPhone|OutlookForWindows|MicrosoftOfficeHub|PowerAutomateDesktop|WindowsMaps|Microsoft.People|Microsoft.Wallet|MicrosoftJournal|Whiteboard|SkypeApp|WindowsFeedbackHub|DevHome|Microsoft.Copilot|LinkedIn|WhatsApp|CandyCrush|king.com|Spotify|Disney|Facebook|Instagram|TikTok|Twitter|Netflix|PrimeVideo|Dolby'; Get-AppxProvisionedPackage -Online | Where-Object { $_.PackageName -match $p } | Remove-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue; Get-AppxPackage -AllUsers | Where-Object { $_.Name -match $p } | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue" 2>nul</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>21</Order>
                    <!-- Block cloud-delivered "suggested"/promoted apps machine-wide
                         (LinkedIn, WhatsApp, Candy Crush, Spotify, TikTok, etc.). These
                         are NOT in the install image; Windows downloads them on first
                         login via Content Delivery Manager unless these policies are set. -->
                    <CommandLine>cmd /c reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" /v "DisableConsumerAccountStateContent" /t REG_DWORD /d 1 /f &amp; reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" /v "DisableCloudOptimizedContent" /t REG_DWORD /d 1 /f &amp; reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" /v "DisableSoftLanding" /t REG_DWORD /d 1 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>22</Order>
                    <!-- Turn off Content Delivery Manager auto-installs and suggestions. -->
                    <CommandLine>cmd /c reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "ContentDeliveryAllowed" /t REG_DWORD /d 0 /f &amp; reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "PreInstalledAppsEnabled" /t REG_DWORD /d 0 /f &amp; reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "OemPreInstalledAppsEnabled" /t REG_DWORD /d 0 /f &amp; reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "PreInstalledAppsEverEnabled" /t REG_DWORD /d 0 /f &amp; reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "FeatureManagementEnabled" /t REG_DWORD /d 0 /f &amp; reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "SubscribedContent-310093Enabled" /t REG_DWORD /d 0 /f &amp; reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "SubscribedContent-338393Enabled" /t REG_DWORD /d 0 /f &amp; reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "SubscribedContent-353694Enabled" /t REG_DWORD /d 0 /f &amp; reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v "SubscribedContent-353696Enabled" /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>23</Order>
                    <!-- Remove OneDrive: disable the sync engine by policy, drop its
                         per-user setup Run entry, and uninstall the setup stub. -->
                    <CommandLine>cmd /c reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\OneDrive" /v "DisableFileSyncNGSC" /t REG_DWORD /d 1 /f &amp; reg delete "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run" /v "OneDriveSetup" /f 2>nul &amp; if exist "%SystemRoot%\SysWOW64\OneDriveSetup.exe" "%SystemRoot%\SysWOW64\OneDriveSetup.exe" /uninstall &amp; if exist "%SystemRoot%\System32\OneDriveSetup.exe" "%SystemRoot%\System32\OneDriveSetup.exe" /uninstall</CommandLine>
                </SynchronousCommand>

                <SynchronousCommand wcm:action="add">
                    <Order>24</Order>
                    <!-- Disable Start-menu app promotions and Windows Copilot. -->
                    <CommandLine>cmd /c reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v "Start_IrisRecommendations" /t REG_DWORD /d 0 /f &amp; reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsCopilot" /v "TurnOffWindowsCopilot" /t REG_DWORD /d 1 /f &amp; reg add "HKCU\SOFTWARE\Policies\Microsoft\Windows\WindowsCopilot" /v "TurnOffWindowsCopilot" /t REG_DWORD /d 1 /f</CommandLine>
                </SynchronousCommand>

            </FirstLogonCommands>

        </component>

        <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35" language="neutral"
                   versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
            <InputLocale>en-US</InputLocale>
            <SystemLocale>en-US</SystemLocale>
            <UILanguage>en-US</UILanguage>
            <UserLocale>en-US</UserLocale>
        </component>

    </settings>

</unattend>

# ---------------------------------------------------------------
# Only these belong in this repo:
#   START HERE.bat, autounattend_predefined-user.xml,
#   autounattend_prompt-user.xml, README.md, .gitignore
# Everything below is ignored on purpose.
# ---------------------------------------------------------------

# Large install media and tools (never commit — they are huge)
*.iso
*.esd
*.wim
*.exe
MediaCreationTool*

# The generated file that gets written onto the USB stick
autounattend.xml

# Internal/technical documentation (not for end users)
docs/
README.txt

# Editor / assistant scratch and local notes
CLAUDE.md
.claude/
.cursor/
.vscode/
memory/
*.log

# OS clutter
Thumbs.db
desktop.ini
.DS_Store

# Local media build workspace (24H2 stick rebuild)
build/

# Driver drop folder - vendor blobs are large and not ours to
# redistribute. Keep the README, ignore the drivers themselves.
drivers/*
!drivers/README.txt
